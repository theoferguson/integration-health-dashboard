# API server
PORT=3001
NODE_ENV=development

# Optional. Without it, the classifier falls back to deterministic mock
# classification based on error keywords - real AI classification is a
# nice-to-have, not required for the dashboard to work.
OPENAI_API_KEY=

# Optional. Defaults to ./data/ihd.db (relative to packages/api).
DB_PATH=

# Social sign-in (open signup) - configure any subset of providers. Each
# provider's OAuth app must register the callback URL
#   <host>/api/auth/callback/<provider>
# e.g. http://localhost:3001/api/auth/callback/github (dev). See README.

# GitHub OAuth App: https://github.com/settings/developers
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Google OAuth 2.0 client: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Facebook Login app: https://developers.facebook.com/apps
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=

# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Falls back to an insecure dev-only default if unset - must be set before deploying.
SESSION_SECRET=
