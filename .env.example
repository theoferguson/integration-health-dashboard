# API server
PORT=3001
NODE_ENV=development

# Optional. Without it, the classifier falls back to deterministic mock
# classification based on error keywords - real AI classification is a
# nice-to-have, not required for the dashboard to work.
OPENAI_API_KEY=

# Optional. Defaults to ./data/ihd.db (relative to packages/api).
DB_PATH=

# GitHub OAuth - open signup, anyone with a GitHub account can sign in and
# create their own projects. Create the OAuth App at
# https://github.com/settings/developers - see README.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Falls back to an insecure dev-only default if unset - must be set before deploying.
SESSION_SECRET=
